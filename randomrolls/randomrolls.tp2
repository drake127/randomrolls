BACKUP ~randomrolls/backup~
AUTHOR ~drake127@planescape.cz~
README ~randomrolls/readme.txt~
VERSION ~1.2.1~
LANGUAGE
	~English~ ~en_US~ ~randomrolls/lang/en_US/setup.tra~


BEGIN @1000
	REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet iwdee pstee~ @1010
	REQUIRE_PREDICATE (~%WEIDU_OS%~ STRING_EQUAL_CASE ~win32~) @1013

	PRINT @1011
	AT_NOW rdrand_available ~randomrolls/tools/cpuid-rdrand.exe~
	ACTION_IF rdrand_available != 0 THEN
	BEGIN
		ABORT @1012
	END

	SILENT
	LOAD_TRA ~randomrolls/lang/signatures.tra~
	VERBOSE
	DEFINE_PATCH_MACRO PATCH_RAND_IN_EXE
	BEGIN
		SET found = 0
		PATCH_FOR_EACH signature_id IN ~1030~ ~1031~ ~1032~ BEGIN
			PATCH_IF found == 0 BEGIN
				SPRINT signature (AT signature_id)
				COUNT_REGEXP_INSTANCES CASE_SENSITIVE EXACT_MATCH ~%signature%~ matches
				PATCH_IF matches == 1 BEGIN
					SET replacement_id = signature_id + 10
					SPRINT replacement (AT replacement_id)
					REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~%signature%~ ~%replacement%~
					SET found = 1
				END
			END
		END
		PATCH_IF found == 0 BEGIN
			PATCH_FAIL @1014
		END
	END

	OUTER_SET exe_found = 0
	ACTION_FOR_EACH exe IN ~BaldurII.exe~ ~Baldur.exe~ ~Icewind.exe~ ~Torment.exe~ BEGIN
		ACTION_IF (exe_found == 0) AND (FILE_EXISTS ~%exe%~) BEGIN
			OUTER_SPRINT exe_file ~%exe%~
			OUTER_SET exe_found = 1
		END
	END

	ACTION_IF exe_found == 0 BEGIN
		FAIL @1015
	END

	COPY ~%exe_file%~ ~%exe_file%~
		LAUNCH_PATCH_MACRO PATCH_RAND_IN_EXE


